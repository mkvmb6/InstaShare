<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Windows 10 SDK target is needed for toast notifications and the share sheet -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<!-- Only for the tray icon (NotifyIcon) -->
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>Assets\InstaShare.ico</ApplicationIcon>
		<!-- Bump for each release; the installer compares it to decide between install and update. -->
		<Version>2.2.1</Version>
		<Product>InstaShare</Product>
		<Company>YourCodeLab</Company>
		<!-- ThemeMode (built-in Fluent theme) is marked experimental -->
		<NoWarn>$(NoWarn);WPF0001</NoWarn>
		<!-- Bundle everything -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<!-- WinForms implicit usings clash with WPF types (Application, Button, ...) -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\InstaShare.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="QRCoder" Version="1.8.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="InstaShare.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- Keys must never end up in the exe; the API holds them now. -->
		<None Remove="credentials.json;r2_credentials.json" />
	</ItemGroup>
</Project>
