<Window x:Class="InstaShare.Views.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install InstaShare" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/InstaShare.ico">
    <StackPanel Margin="28,24,28,22">
        <DockPanel Margin="0,0,0,18">
            <Image Source="pack://application:,,,/Assets/InstaShare.ico" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Install InstaShare" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="Subheading" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Share files and folders with a link, straight from Explorer." />
            </StackPanel>
        </DockPanel>

        <StackPanel x:Name="Choices">
            <CheckBox x:Name="ContextMenuBox" Margin="0,0,0,6">
                <TextBlock TextWrapping="Wrap">Add "Share with InstaShare" to the right-click menu</TextBlock>
            </CheckBox>
            <CheckBox x:Name="SendToBox" Content="Add InstaShare to the Send to menu" Margin="0,0,0,6" />
            <CheckBox x:Name="StartupBox" Content="Start with Windows" Margin="0,0,0,6" />
            <CheckBox x:Name="DesktopBox" Content="Create a desktop shortcut" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0">
                Installs for you only, no admin rights needed. You can change these later in Settings, and remove InstaShare from Apps &amp; features.
            </TextBlock>
        </StackPanel>

        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Margin="0,16,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButtonStyle}" MinWidth="96" IsDefault="True" Click="Install_Click" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
